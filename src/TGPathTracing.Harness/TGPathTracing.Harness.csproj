<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\Build.Local.props" Condition="Exists('..\..\Build.Local.props')" />
  <Import Project="..\Game.References.props" />
  <PropertyGroup>
    <AssemblyName>TGPathTracing.Harness</AssemblyName>
    <RootNamespace>TGPathTracing.Harness</RootNamespace>
    <Version>1.2.3</Version>
    <!-- A developer's tool for the Mono version, where TG Path Tracing runs. It is in no release zip
         (tools/Package.Common.ps1 does not name it): tools/harness/Run-PtHarness.ps1 builds and installs it. -->
    <TargetFrameworks>net472</TargetFrameworks>
  </PropertyGroup>
  <!-- No reference to TG Path Tracing or the bridge: the runner drives whatever build is installed through its
       BepInEx config entries and reads its state by name (Traced.cs), so an older build can be measured too. -->
  <ItemGroup>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(UnityReferenceDir)\UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(UnityReferenceDir)\UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(UnityReferenceDir)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <!-- AudioListener.volume: no sound during a run. -->
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(UnityReferenceDir)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <!-- Physics.RaycastAll: a walk keeps the camera over the ground (CameraSlide). -->
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(UnityReferenceDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <!-- The game's own Json.NET: Unity's JsonUtility leaves out the nested classes of an assembly BepInEx loaded
         (a request's scenarios came back empty, the list of saves was written without its saves). -->
    <Reference Include="Newtonsoft.Json"><HintPath>$(UnityReferenceDir)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
