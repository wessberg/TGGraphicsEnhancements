<!-- SPDX-License-Identifier: MIT -->
<!-- TG Graphics Bridge's preloader, built into every mod that bundles the bridge: each mod's
     src/<Mod>.Autoload project sets its AssemblyName, compiles these sources and its own Identity.cs. -->
<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\..\Build.Local.props" Condition="Exists('$(MSBuildThisFileDirectory)..\..\Build.Local.props')" />
  <PropertyGroup>
    <TargetFrameworks>net472;net6.0</TargetFrameworks>
    <RootNamespace>TGGraphicsBridge.Autoload</RootNamespace>
    <Version>1.2.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Shipped DLLs name no local folders: build paths (including the PDB path) are mapped. -->
    <PathMap>$(MSBuildProjectDirectory)=$(MSBuildProjectName),$(MSBuildThisFileDirectory)=TGGraphicsBridge.Autoload</PathMap>
    <GameDirMono Condition="'$(GameDirMono)' == ''">C:\Games\Tainted Grail FoA Mono</GameDirMono>
    <GameDirIl2Cpp Condition="'$(GameDirIl2Cpp)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Tainted Grail FoA</GameDirIl2Cpp>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <DefineConstants>$(DefineConstants);BEPINEX_MONO</DefineConstants>
    <CoreDir Condition="'$(MonoCoreDir)' != ''">$(MonoCoreDir)</CoreDir>
    <CoreDir Condition="'$(MonoCoreDir)' == ''">$(GameDirMono)\BepInEx\core</CoreDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <DefineConstants>$(DefineConstants);BEPINEX_IL2CPP</DefineConstants>
    <CoreDir Condition="'$(Il2CppCoreDir)' != ''">$(Il2CppCoreDir)</CoreDir>
    <CoreDir Condition="'$(Il2CppCoreDir)' == ''">$(GameDirIl2Cpp)\BepInEx\core</CoreDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <RequiredCore Include="BepInEx;Mono.Cecil" />
    <Reference Include="BepInEx"><HintPath>$(CoreDir)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(CoreDir)\Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <RequiredCore Include="BepInEx.Core;BepInEx.Preloader.Core" />
    <Reference Include="BepInEx.Core"><HintPath>$(CoreDir)\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Preloader.Core"><HintPath>$(CoreDir)\BepInEx.Preloader.Core.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Bootstrap.cs;$(MSBuildThisFileDirectory)Patcher.cs" />
  </ItemGroup>
  <Target Name="ValidateReferences" BeforeTargets="ResolveReferences" Condition="'$(TargetFramework)' != ''">
    <Error Condition="!Exists('$(CoreDir)\%(RequiredCore.Identity).dll')" Text="Missing $(CoreDir)\%(RequiredCore.Identity).dll. Select the corresponding installed BepInEx runtime." />
  </Target>
</Project>
