<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\Build.Local.props" Condition="Exists('..\..\Build.Local.props')" />
  <Import Project="..\Game.References.props" />
  <PropertyGroup>
    <AssemblyName>TGBetterUpscaling</AssemblyName>
    <RootNamespace>TGBetterUpscaling</RootNamespace>
    <Version>1.2.4</Version>
  </PropertyGroup>
  <!-- TG Graphics Bridge, bundled in this mod's package by Build.ps1 (the build does not copy it), and
       this mod's copy of the bridge's preloader, built alongside but never loaded as a dependency. -->
  <ItemGroup>
    <Compile Include="..\Shared\CustomPassRecorder.cs" Link="Shared\CustomPassRecorder.cs" />
    <ProjectReference Include="..\TGGraphicsBridge\TGGraphicsBridge.csproj" Private="false" />
    <ProjectReference Include="..\TGBetterUpscaling.Autoload\TGBetterUpscaling.Autoload.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <!-- Unity's NVIDIA module: the render size NVIDIA recommends for each DLSS quality mode. -->
  <ItemGroup>
    <Reference Include="UnityEngine.NVIDIAModule"><HintPath>$(UnityReferenceDir)\UnityEngine.NVIDIAModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
