<Project Sdk="Microsoft.NET.Sdk">
  <!-- TG Frame Generation's copy of TG Graphics Bridge's preloader: its own assembly and patcher ID, so that it
       loads beside the copy another mod bundles (see src/TGGraphicsBridge.Autoload/Bootstrap.cs). -->
  <PropertyGroup>
    <AssemblyName>TGFrameGeneration.Autoload</AssemblyName>
  </PropertyGroup>
  <Import Project="..\TGGraphicsBridge.Autoload\Autoload.props" />
</Project>
