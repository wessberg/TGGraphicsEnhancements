<Project Sdk="Microsoft.NET.Sdk">
  <!-- TG Graphics Bridge's install check on game folders laid out the ways players unpack the mods,
       without the game (the notices are stand-ins). -->
  <Import Project="..\Build.Local.props" Condition="Exists('..\Build.Local.props')" />
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <DefineConstants>BEPINEX_MONO</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameDirMono Condition="'$(GameDirMono)' == ''">C:\Games\Tainted Grail FoA Mono</GameDirMono>
    <TestCoreDir>$(GameDirMono)\BepInEx\core</TestCoreDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
    <Reference Include="BepInEx"><HintPath>$(TestCoreDir)\BepInEx.dll</HintPath></Reference>
    <Compile Include="..\src\TGGraphicsBridge\InstallCheck.cs" Link="InstallCheck.cs" />
    <Compile Include="..\src\TGGraphicsBridge\ReportText.cs" Link="ReportText.cs" />
    <Compile Include="install_check_tests.cs" />
  </ItemGroup>
</Project>
