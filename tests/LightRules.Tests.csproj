<Project Sdk="Microsoft.NET.Sdk">
  <!-- TG Path Tracing's light rules (which left-out light stands at a glowing thing, and each light's traced size), without the game. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="..\src\TGPathTracing\LightRules.cs" Link="LightRules.cs" />
    <Compile Include="light_rules_tests.cs" />
  </ItemGroup>
</Project>
