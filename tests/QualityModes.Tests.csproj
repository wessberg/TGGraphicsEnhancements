<Project Sdk="Microsoft.NET.Sdk">
  <!-- The quality-mode rules of TG Better Upscaling (which mode a render scale starts on), without the game. -->
  <PropertyGroup>
    <TestRuntime Condition="'$(TestRuntime)' == ''">Mono</TestRuntime>
    <TargetFramework Condition="'$(TestRuntime)' == 'Mono'">net472</TargetFramework>
    <TargetFramework Condition="'$(TestRuntime)' == 'IL2CPP'">net6.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" Condition="'$(TestRuntime)' == 'Mono'" />
    <Compile Include="..\src\TGBetterUpscaling\QualityModes.cs" Link="QualityModes.cs" />
    <Compile Include="quality_modes_tests.cs" />
  </ItemGroup>
</Project>
